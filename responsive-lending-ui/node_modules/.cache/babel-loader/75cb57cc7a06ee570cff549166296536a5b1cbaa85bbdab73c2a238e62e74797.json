{"ast":null,"code":"export function formatCurrency(amount){if(amount===null||amount===undefined||amount==='')return'';const n=Number(amount);if(Number.isNaN(n))return'';return`$${n.toLocaleString('en-AU')}`;}export function formatAnswerForSummary(step,value){if(value===null||value===undefined)return'—';switch(step.type){case'currency':return formatCurrency(value);case'choice':{const match=step.options.find(opt=>opt.value===value);return match?match.label:String(value);}case'name':return`${value.firstName} ${value.lastName}`;default:return String(value);}}","map":{"version":3,"names":["formatCurrency","amount","undefined","n","Number","isNaN","toLocaleString","formatAnswerForSummary","step","value","type","match","options","find","opt","label","String","firstName","lastName"],"sources":["C:/Users/surya/OneDrive/Desktop/catalyst/responsive-lending/responsive-lending-ui/src/utils/formatters.js"],"sourcesContent":["export function formatCurrency(amount) {\n  if (amount === null || amount === undefined || amount === '') return '';\n  const n = Number(amount);\n  if (Number.isNaN(n)) return '';\n  return `$${n.toLocaleString('en-AU')}`;\n}\n\nexport function formatAnswerForSummary(step, value) {\n  if (value === null || value === undefined) return '—';\n  switch (step.type) {\n    case 'currency':\n      return formatCurrency(value);\n    case 'choice': {\n      const match = step.options.find((opt) => opt.value === value);\n      return match ? match.label : String(value);\n    }\n    case 'name':\n      return `${value.firstName} ${value.lastName}`;\n    default:\n      return String(value);\n  }\n}\n"],"mappings":"AAAA,MAAO,SAAS,CAAAA,cAAcA,CAACC,MAAM,CAAE,CACrC,GAAIA,MAAM,GAAK,IAAI,EAAIA,MAAM,GAAKC,SAAS,EAAID,MAAM,GAAK,EAAE,CAAE,MAAO,EAAE,CACvE,KAAM,CAAAE,CAAC,CAAGC,MAAM,CAACH,MAAM,CAAC,CACxB,GAAIG,MAAM,CAACC,KAAK,CAACF,CAAC,CAAC,CAAE,MAAO,EAAE,CAC9B,MAAO,IAAIA,CAAC,CAACG,cAAc,CAAC,OAAO,CAAC,EAAE,CACxC,CAEA,MAAO,SAAS,CAAAC,sBAAsBA,CAACC,IAAI,CAAEC,KAAK,CAAE,CAClD,GAAI